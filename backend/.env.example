# Copiar a .env (o exportar en la terminal) y rellenar con valores reales.
# La URI de Atlas incluye usuario y contraseña: NO versionarla.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=ministock

# Cadena de al menos 32 caracteres para HS256
JWT_SECRET=cambiar-por-una-clave-secreta-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=86400000

ADMIN_EMAIL=admin@ministock.com
ADMIN_PASSWORD=admin123

CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080
